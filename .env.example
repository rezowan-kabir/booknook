# Public backend API root. Set both variables to the externally reachable backend URL.
BACKEND_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000

# Full URL of the backend's New Arrivals endpoint.
BACKEND_NEW_ARRIVEL_URL=http://localhost:8000/new-arrivals

# Required for authentication.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
MONGO_DB_URL=mongodb+srv://<user>:<password>@<cluster>/<database>

# Required for book cover uploads. This key is exposed to the browser.
NEXT_PUBLIC_IMGBB_API_KEY=replace-with-your-imgbb-api-key

# Optional; configure both to enable GitHub sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
